# Blank configuration reference. Never put real secrets in this tracked file.
# Copy to an ignored .env.local file for local use.
# Spring Boot needs these values injected as process/deployment environment variables;
# it does not automatically load this root .env file.

# Backend-only credentials. Never expose these with a VITE_ prefix.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/pzh_cinema?serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0
# Actual local Redis may use another port; match its existing service configuration.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Optional exact CORS origins. Leave unset to use the selected profile's defaults.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JWT support is reserved for the next development phase; no key is used yet.
JWT_SECRET=
MAP_SERVER_API_KEY=
WECHAT_APP_SECRET=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=

# Public client configuration only. VITE_* values are visible in built client code.
# A browser map key must be restricted by domain/app and provider quotas.
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_MAP_BROWSER_KEY=
